{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["webextension-polyfill"]
  },
  "include": ["entrypoints/**/*.ts", "lib/**/*.ts", "wxt.config.ts"]
}
